{
  "name": "world-country",
  "version": "2.0.0",
  "description": "A TypeScript library for working with country data including dial codes, country names, and ISO codes",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --no-cache --ci --coverage",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "eslint \"{src,tests}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackinno/world-country.git"
  },
  "keywords": [
    "country",
    "code",
    "country",
    "phone",
    "code",
    "world",
    "wild",
    "code"
  ],
  "author": "Thotsaphon Ben Ruthamnong<r.thotsaphon@hotmail.co.th>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/blackinno/world-country/issues"
  },
  "homepage": "https://github.com/blackinno/world-country#readme",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  }
}
